; serve.bl — a .bl.org dossier as a live page that listens back.
;
;   bl serve serve.bl -- /abs/path/doc.bl.org
;   PORT / HOST from the environment (work serve supplies them), else 4071.
;   DOSSIER_OWNER=login@domain  → only that Tailscale identity may answer.
;   DOSSIER_HANDLE=handle       → the name answers carry in :by (else the
;                                 login's part before @; never the email).
;   DOSSIER_MODE=client         → only the client's reading (dossier/audience.bl):
;                                 no /src, no answers, no review thread.
;   ?mode=client on / and /doc  → the author previews that reading.
;
; Routes: GET /        the page        GET /doc   {rev html} for live refresh
;         GET /rev     {rev}           GET /src   the .bl.org itself
;         GET /answers every answer    POST /answer {id answer note}

(ns serve
  (:require [web] [live.hiccup :as h] [bl.json :as json]
            [dossier.org :as o] [dossier.page :as pg] [dossier.answer :as ans] [dossier.film :as film]
            [dossier.feedback :as feedback] [dossier.witness :as witness] [dossier.review.http :as review] [dossier.notebook :as nb] [dossier.audience :as audience]))

(defn- arg-path []
  (let [a (first (BeamLisp/argv))]
    (when (nil? a) (throw (ex-info "usage: bl serve serve.bl -- FILE.bl.org" {})))
    (Path/expand a)))

(def doc-path (arg-path))
(defn- asset [name]
  (File/read! (Path/join (or (System/get_env "DOSSIER_KIT_DIR") (Path/expand "~/.claude/skills/bl-org-dossier/kit")) name)))

(defn- rev [text]
 (let [doc (read-doc text)]
   (str (erlang/phash2 [(review/content-source text) (mapv :data (filter (fn [node] (= "witness" (:lang node))) (:nodes doc)))
                        (mapv :lines (:imports doc))]))))

;; a film block's recorded run is read from disk here, so the page stays pure
(defn- read-doc [text] (nb/with-imports (witness/enrich (film/enrich (o/read-doc text) (Path/dirname doc-path)) (Path/dirname doc-path)) (Path/dirname doc-path)))

(defn- owner-ok? [conn]
  (let [owner (System/get_env "DOSSIER_OWNER")]
    (or (blank? owner) (= owner (web/req-header conn "tailscale-user-login")))))

(defn- param
  "One query parameter (`?design=sober`), decoded; nil when absent."
  [conn k]
  (some (fn [pair] (let [kv (String/split pair "=")]
                     (when (= k (web/url-decode (first kv))) (web/url-decode (or (last kv) "")))))
        (String/split (or (web/query conn) "") "&")))

(def ^:private designs #{"sober" "warm-signal"})

(defn- reading
  "The document as this request reads it: its client reading (`?mode=client`,
   `DOSSIER_MODE=client`) and its design (`?design=sober`, preview only).
   `:dossier/params` carries both into every same-origin host on the page."
  [conn text]
  (let [mode (audience/mode-of (web/query conn))
        asked (param conn "design")
        doc (audience/view (read-doc text) mode (audience/locked?))
        doc (if (contains? designs asked) (assoc-in doc [:meta :design] asked) doc)]
    (erlang/put :dossier/params
                (join "&" (keep (fn [x] x)
                             [(when (= "client" mode) "mode=client")
                              (when (contains? designs asked) (str "design=" asked))])))
    doc))

(defn- full-page [conn text]
  (str "<!doctype html>" (h/hiccup->html (pg/page-h (reading conn text) (asset "style.css") (asset "live.js")))))

(defn- doc-json [conn text]
  {:rev (rev text) :html (join "" (map h/hiccup->html (pg/doc-h (reading conn text))))})

(defn- client-only [conn]
  (when (and (audience/locked?) (contains? #{"/src" "/answers" "/answer"} (web/path conn)))
    (web/text conn 404 "not found")))

(defn- post-answer [conn]
  (if (not (owner-ok? conn))
    (web/json conn 403 {:error "only the dossier owner can answer (Tailscale identity)"})
    (let [[body conn] (web/read-body* conn)
          result (feedback/submit! doc-path
                   (or (ans/handle (web/req-header conn "tailscale-user-login")
                                   (System/get_env "DOSSIER_HANDLE")) "") body)]
      (web/json conn (:status result) (:body result)))))

(defn router [conn]
 (or (client-only conn)
     (when-not (audience/locked?) (review/route conn doc-path))
 (let [match (Regex/run (Regex/compile! "^/witness-media/([A-Za-z0-9_-]+)/(frame-[1-9][0-9]*\\.png)$") (web/path conn))]
  (if match
   (if-let [path (witness/media-path (o/read-doc (File/read! doc-path)) (Path/dirname doc-path) (nth match 1) (nth match 2))]
    (web/bytes (web/resp-header conn "cache-control" "private, no-store") "image/png" (File/read! path))
    (web/text conn 404 "Recorded frame unavailable"))
   (web/route conn
    [:get "/"] (web/html conn (full-page conn (File/read! doc-path)))
    [:get "/doc"] (web/json conn (doc-json conn (File/read! doc-path)))
    [:get "/rev"] (web/json conn {:rev (rev (File/read! doc-path))})
    [:get "/src"] (web/text conn (File/read! doc-path))
    [:get "/answers"] (web/json conn (vec (map (fn [i] (into {} (for [[k v] i :when v] [(name k) v])))
                                               (pg/feedback-items (o/read-doc (File/read! doc-path))))))
    [:post "/answer"] (post-answer conn)
    :else (web/text conn 404 "not found"))))))

(def port (let [p (System/get_env "PORT")] (if p (erlang/binary_to_integer p) 4071)))

;; Pay one full render before the first reader: loading a namespace after
;; web/serve has pinned this file is what beam-lisp refuses (code_leased).
(pg/page-h (read-doc (File/read! doc-path)) "" "")

(web/serve {:port port :ip (tuple 127 0 0 1) :plug router :log :off})
(println (str "dossier: " doc-path " on http://127.0.0.1:" port "/"))
