; serve.bl — a .bl.org dossier as a live page that listens back.
;
;   bl serve serve.bl -- /abs/path/doc.bl.org
;   PORT / HOST from the environment (work serve supplies them), else 4071.
;   DOSSIER_OWNER=login@domain  → only that Tailscale identity may answer.
;   DOSSIER_HANDLE=handle       → the name answers carry in :by (else the
;                                 login's part before @; never the email).
;   DOSSIER_DESIGN_CSS=/abs/a.css,/abs/b.css → design languages that live with
;                                 their product (a private repo, say): each file
;                                 styles `.design-NAME` and is appended to the
;                                 kit's CSS; `:design NAME` / `#+design: NAME`
;                                 then draw mockups in it. Read per request.
;
; Routes: GET /        the page        GET /doc   {rev html} for live refresh
;         GET /rev     {rev}           GET /src   the .bl.org itself
;         GET /answers every answer    POST /answer {id answer note}

(ns serve
  (:require [web] [live.hiccup :as h] [bl.json :as json]
            [dossier.org :as o] [dossier.page :as pg] [dossier.answer :as ans] [dossier.film :as film]))

(defn- arg-path []
  (let [a (first (BeamLisp/argv))]
    (when (nil? a) (throw (ex-info "usage: bl serve serve.bl -- FILE.bl.org" {})))
    (Path/expand a)))

(def doc-path (arg-path))
(defn- asset [name]
  (File/read! (Path/join (or (System/get_env "DOSSIER_KIT_DIR") (Path/expand "~/.claude/skills/bl-org-dossier/kit")) name)))

(defn- product-designs
  "CSS of design languages kept outside the kit (DOSSIER_DESIGN_CSS)."
  []
  (join "\n" (for [p (split (or (System/get_env "DOSSIER_DESIGN_CSS") "") ",")
                   :let [p (trim p)] :when (and (not= "" p) (File/regular? p))]
               (File/read! p))))

(defn- rev [text] (str (erlang/phash2 text)))

;; a film block's recorded run is read from disk here, so the page stays pure
(defn- read-doc [text] (film/enrich (o/read-doc text) (Path/dirname doc-path)))

(defn- owner-ok? [conn]
  (let [owner (System/get_env "DOSSIER_OWNER")]
    (or (blank? owner) (= owner (web/req-header conn "tailscale-user-login")))))

(defn- full-page [text]
  (str "<!doctype html>" (h/hiccup->html (pg/page-h (read-doc text) (str (asset "style.css") "\n" (product-designs)) (asset "live.js")))))

(defn- doc-json [text]
  {:rev (rev text) :html (join "" (map h/hiccup->html (pg/doc-h (read-doc text))))})

(defn- post-answer [conn]
  (let [[body conn] (web/read-body* conn)
        req (json/decode body)]
    (if (not (owner-ok? conn))
      (web/json conn 403 {:error "only the dossier owner can answer (Tailscale identity)"})
      (let [r (ans/answer! doc-path (get req "id") (or (get req "answer") "") (or (get req "note") "")
                           (or (ans/handle (web/req-header conn "tailscale-user-login")
                                           (System/get_env "DOSSIER_HANDLE")) ""))]
        (if (:error r)
          (web/json conn 404 {:error (:error r)})
          (web/json conn 200 {:ok true :rev (rev (File/read! doc-path))}))))))

(defn router [conn]
  (web/route conn
    [:get "/"] (web/html conn (full-page (File/read! doc-path)))
    [:get "/doc"] (web/json conn (doc-json (File/read! doc-path)))
    [:get "/rev"] (web/json conn {:rev (rev (File/read! doc-path))})
    [:get "/src"] (web/text conn (File/read! doc-path))
    [:get "/answers"] (web/json conn (vec (map (fn [i] (into {} (for [[k v] i :when v] [(name k) v])))
                                               (pg/feedback-items (o/read-doc (File/read! doc-path))))))
    [:post "/answer"] (post-answer conn)
    :else (web/text conn 404 "not found")))

(def port (let [p (System/get_env "PORT")] (if p (erlang/binary_to_integer p) 4071)))

(web/serve {:port port :ip (tuple 127 0 0 1) :plug router :log :off})
(println (str "dossier: " doc-path " on http://127.0.0.1:" port "/"))
