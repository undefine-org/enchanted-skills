; dossier/page.bl — a whole document as one page.
;
; Level-1 headings become sections and nav chips; runs of screen blocks
; become one sideways strip; a `Roster` section gets its progress tiles;
; every cell shows its last recorded result as proof. Pure.

(ns dossier.page
  (:require [dossier.org :as o] [dossier.ui :as ui] [dossier.design :as design] [dossier.film :as film]
            [dossier.runview :as rv] [dossier.horizon :as hz] [dossier.witness :as witness]
            [dossier.milestones :as milestones] [dossier.claims :as claims] [dossier.audience :as audience] [dossier.lifetime :as lifetime] [dossier.notebook :as nb] [dossier.review.ui :as review]))

(def answerable #{"ask" "decision" "screen" "screen_graph" "desk" "job" "schema" "procedure" "film" "run" "horizons" "witness" "milestones" "claims" "lifetime"
                  "ontology_graph" "settings_graph" "code_graph" "settings_pages" "roster"})

(defn- with-design
  "`#+design: NAME` draws every screen, run and desk without its own :design in that language."
  [d nodes]
  (if (blank? (str d))
    nodes
    (vec (for [nd nodes]
           (if (and (= :block (:t nd)) (contains? #{"screen" "screen_graph" "desk" "run" "horizons"} (:lang nd)) (nil? (:design (:attrs nd))))
             (assoc-in nd [:attrs :design] (trim d))
             nd)))))

(defn- with-procedures
  "Each run block gets the procedure (from this document) its :procedure names."
  [nodes]
  (let [procs (into {} (for [nd nodes :when (and (= :block (:t nd)) (= "procedure" (:lang nd)) (:id (:attrs nd)))]
                         [(:id (:attrs nd)) (rv/procedure-of-node nd)]))]
    (vec (for [nd nodes]
           (if (and (= :block (:t nd)) (= "run" (:lang nd)))
             (assoc nd :proc (get procs (:procedure (:attrs nd))))
             nd)))))

(defn- phone-tree [b]
  (if (= "run" (:lang b))
    (if (:proc b) (rv/run-h b (:proc b)) [:pre.block (str "run: no procedure " (:procedure (:attrs b)) " in this document")])
    (ui/screen-h b)))

(defn- phone-h [b] (review/decorate b (phone-tree b)))

(defn- group-screens
  "Consecutive screen and run blocks (blank prose between them aside) as one strip."
  [nodes]
  (reduce (fn [out nd]
            (let [prev (last out)]
              (if (and (= :block (:t nd)) (contains? #{"screen" "run"} (:lang nd)))
                (if (= :screens (:t prev))
                  (conj (pop out) (update prev :blocks conj nd))
                  (conj out {:t :screens :blocks [nd]}))
                (conj out nd))))
          [] nodes))

(defn- todo-chip [k] (when k [:span {:class (str "kw " k)} k]))

(defn- node-tree [nd]
  (case (:t nd)
    :heading (let [tag (keyword (str "h" (min 6 (inc (:level nd)))))]
               [tag {:id (ui/slug (:title nd))}
                (todo-chip (:todo nd)) (ui/md (:title nd))
                (for [t (:tags nd)] [:span.tag t])])
    :para [:p (if (and (erlang/get :dossier/notebook) (includes? (:text nd) "{{")) (nb/inline (:text nd)) (ui/md (:text nd)))]
    :list [(if (:ordered? nd) :ol :ul)
           (for [it (:items nd)]
             (cond (starts-with? it "[X] ") [:li.check.done (ui/md (subs it 4))]
                   (starts-with? it "[ ] ") [:li.check (ui/md (subs it 4))]
                   (and (erlang/get :dossier/notebook) (includes? it "{{")) [:li (nb/inline it)]
                   :else [:li (ui/md it)]))]
    :table [:div.scrollx
            [:table
             (when (seq (:head nd)) [:thead (for [r (:head nd)] [:tr (for [c r] [:th (ui/md c)])])])
             [:tbody (for [r (:rows nd)] [:tr (for [c r] [:td (ui/md c)])])]]]
    :props [:div.props (for [[k v] (:pairs nd)] [:span [:b k] (ui/md v)])]
    :block (if-let [render (:render-block nd)] (render nd) (case (:lang nd)
             "film" (film/film-h nd)
             "witness" (witness/witness-h nd)
             "milestones" (milestones/milestones-h nd)
             "claims" (claims/claims-h nd)
             "lifetime" (lifetime/lifetime-h nd)
             "run" (phone-h nd)
             "horizons" (hz/horizons-h nd)
             (or (nb/block-h nd) (design/block-h nd) (ui/block->h nd))))
    :screens [:div.screens (map phone-h (:blocks nd))]
    :cell [:section {:class (str "cell" (if (:error? nd) " failed" "")) :id (str "cell-" (:id nd))}
           [:div.cell-head
            [:span.badge (cond (:error? nd) "✗ failed" (:result nd) "✓ ran" :else "not run")]
            [:code (:id nd)] [:span.lang "beam-lisp"]]
           (when (:result nd) [:pre.result (:result nd)])
           [:details [:summary (str "model source · " (count (String/split (:code nd) "\n")) " lines")]
            [:pre.src (:code nd)]]]
    :code [:pre {:class (str "code " (:lang nd))} (:body nd)]
    nil))

(defn- node->h [nd] (review/decorate nd (node-tree nd)))

(defn- sections
  "Nodes split at level-1 headings: [{:head h :nodes […]} …]."
  [nodes]
  (reduce (fn [out nd]
            (if (and (= :heading (:t nd)) (= 1 (:level nd)))
              (conj out {:head nd :nodes []})
              (if (empty? out)
                [{:head nil :nodes [nd]}]
                (conj (pop out) (update (last out) :nodes conj nd)))))
          [] nodes))

(defn- roster-h [nodes]
  (let [kws (keep :todo (filter (fn [nd] (= :heading (:t nd))) nodes))
        counts (frequencies kws)
        total (max 1 (count kws))
        order (vec (distinct (concat ["DONE" "DOING" "NEXT" "WAIT" "REVIEW" "TODO" "BLOCKED" "DROP"] (sort (keys counts)))))]
    (when (seq kws)
      (list
        [:div.tiles (for [k order :when (get counts k)] [:div.tile [:b (get counts k)] [:span (lower-case k)]])]
        [:div.bar (for [k order :when (get counts k)]
                    [:i {:class (str "seg " k) :style (str "width:" (/ (* 100.0 (get counts k)) total) "%")}])]))))

(defn feedback-items
  "Every answerable block: [{:id :lang :title :answer :note :at} …]."
  [doc]
  (for [nd (:nodes doc) :when (and (= :block (:t nd)) (contains? answerable (:lang nd)) (:id (:attrs nd)))]
    (let [a (:attrs nd)]
      {:id (:id a) :lang (:lang nd) :title (or (:title a) "") :answer (:answer a) :note (:note a) :at (:at a)})))

(defn- tally-h [doc]
  (let [items (feedback-items doc)
        open (filter (fn [i] (nil? (:answer i))) items)
        asks (filter (fn [i] (contains? #{"ask" "decision"} (:lang i))) open)]
    [:div.tally
     [:span.tally-n (str (- (count items) (count open)) "/" (count items))]
     [:span (ui/tr "answered")]
     (when (seq asks)
       [:a.next {:href (str "#" (:lang (first asks)) "-" (:id (first asks)))}
        (str (count asks) (ui/tr " questions wait for you →"))])]))

(defn- sec-id [s] (if (:head s) (str "s-" (ui/slug (:title (:head s)))) "s-intro"))

(defn- sec-asks
  "Answerable blocks of a section: [answered total]."
  [s]
  (let [bs (filter (fn [nd] (and (= :block (:t nd)) (contains? answerable (:lang nd)) (:id (:attrs nd))))
                   (mapcat (fn [nd] (if (= :screens (:t nd)) (:blocks nd) [nd])) (:nodes s)))]
    [(count (filter (fn [b] (:answer (:attrs b))) bs)) (count bs)]))

(defn- sub-heading? [nd] (and (= :heading (:t nd)) (= 2 (:level nd))))

(defn- chunks
  "A section's nodes split at its level-2 headings: [lead [[h2 nodes…] …]]."
  [nodes]
  (let [lead (vec (take-while (fn [nd] (not (sub-heading? nd))) nodes))
        rest-nodes (drop (count lead) nodes)]
    [lead (reduce (fn [out nd] (if (sub-heading? nd) (conj out [nd]) (conj (pop out) (conj (last out) nd))))
                  [] rest-nodes)]))

(defn- paged?
  "`#+subpages: t` pages every section by its subsections; `#+subpages: A | B` only those named."
  [meta s]
  (let [v (trim (str (:subpages meta))) names (set (map trim (String/split v "|")))]
    (and (:head s) (some sub-heading? (:nodes s))
         (or (= "t" v) (contains? names (:title (:head s)))))))

(defn- pages
  "Every page a reader steps through: a section, or each subsection of a paged one."
  [meta secs]
  (vec (mapcat (fn [s]
                 (if (paged? meta s)
                   (for [[h] (second (chunks (:nodes s)))]
                     {:href (str "#" (ui/slug (:title h))) :title (:title h) :sec (sec-id s)})
                   [{:href (str "#" (sec-id s)) :title (if (:head s) (:title (:head s)) "Overview") :sec (sec-id s)}]))
               secs)))

(defn- pager-h [all i]
  [:nav.pager
   (when (> i 0) (let [p (get all (dec i))] [:a.prev {:href (:href p)} "← " (ui/mdi (:title p))]))
   (when (< (inc i) (count all)) (let [x (get all (inc i))] [:a.next {:href (:href x)} (ui/mdi (:title x)) " →"]))])

(defn- side-h
  "The sections as an app's sidebar: where you are, what waits for an answer,
   how far a roster got. A section's subsections sit under it. Purely a view of the same file."
  [meta secs]
  [:aside.side
   [:a.side-title {:href "#s-intro"} (ui/md (String/replace (or (:title meta) "Dossier") (Regex/compile! "\\s+—.*$") ""))]
   [:nav.side-nav
    (for [s secs]
      (let [[ok n] (sec-asks s)
            kws (keep :todo (filter (fn [nd] (= :heading (:t nd))) (:nodes s)))
            done (count (filter (fn [k] (= "DONE" k)) kws))
            subs (filter sub-heading? (:nodes s))]
        [:div {:class (str "side-item" (when (seq subs) " has-subs") (when (paged? meta s) " paged")) :data-sec (sec-id s)}
         [:a.side-sec {:href (str "#" (sec-id s))}
          [:span.st (if (:head s) (ui/md (:title (:head s))) "Overview")]
          (cond (> n ok) [:span.wait {:title "waiting for your answer"} (- n ok)]
                (> n 0) [:span.ok {:title (ui/tr "answered")} "✓"]
                (seq kws) [:span.prog {:title "done / total"} (str done "/" (count kws))]
                (seq subs) [:span.count (count subs)]
                :else nil)]
         (when (seq subs)
           [:div.side-subs (for [h subs] [:a {:href (str "#" (ui/slug (:title h))) :data-sub (ui/slug (:title h))} (ui/md (:title h))])])]))]
   [:a.side-all {:href "#all"} (ui/tr "Whole document")]])

(defn doc-h
  "The document body (sidebar, header, nav and sections) as hiccup."
  [doc]
  (let [meta (:meta doc)
        _ (erlang/put :dossier/language (:language meta))
        nbc (nb/context doc)
        _ (erlang/put :dossier/notebook nbc)
        dock (first (filter (fn [nd] (and (= :block (:t nd)) (= "scenarios" (:lang nd)))) (:nodes doc)))
        secs (vec (sections (group-screens (with-procedures (with-design (:design meta) (:nodes doc))))))
        n (count secs)]
    (list
      [:div {:class "app2" :data-design (:design meta) :data-layout (:layout meta) :data-mode (:mode meta)}
       (side-h meta secs)
       [:div.content
        [:header.doc
         (when (:kicker meta) [:div.kicker (ui/md (:kicker meta))])
         [:h1 (ui/md (or (:title meta) "Untitled"))]
         (when (:subtitle meta) [:div.sub (ui/md (:subtitle meta))])
         [:div.meta
          (when (:date meta) [:span (:date meta)])
          (when (:status meta) [:span (ui/md (:status meta))])
          (when (:author meta) [:span (:author meta)])]
         (when-not (audience/client? doc) (tally-h doc))]
        [:nav.chips (for [s secs :when (:head s)]
                      [:a {:href (str "#" (ui/slug (:title (:head s))))} (:title (:head s))])
         [:a.all {:href "#all"} "All"]]
        (let [all (pages meta secs)
              at (fn [href] (or (first (keep-indexed (fn [i p] (when (= href (:href p)) i)) all)) 0))]
          (for [s secs]
            [:section {:class (str "part" (when (paged? meta s) " paged")) :id (sec-id s) :data-sec (sec-id s)}
             (when (:head s) (node->h (:head s)))
             (when (and (:head s) (= "roster" (lower-case (:title (:head s))))) (roster-h (:nodes s)))
             (if (paged? meta s)
               (let [[lead subs] (chunks (:nodes s))]
                 (list
                   [:nav.subnav {:aria-label (if (:head s) (:title (:head s)) "Section")}
                    (for [[h] subs] [:a {:href (str "#" (ui/slug (:title h))) :data-sub (ui/slug (:title h))} (ui/mdi (:title h))])]
                   (when (seq lead) [:div.sub-lead (keep node->h lead)])
                   (for [[h & body] subs :let [href (str "#" (ui/slug (:title h)))]]
                     [:div.subpage {:data-sub (ui/slug (:title h))}
                      (node->h h) (keep node->h body) (pager-h all (at href))])))
               (list (keep node->h (:nodes s)) (pager-h all (at (str "#" (sec-id s))))))]))
        (when-let [p (nb/payload nbc)]
          (list [:div#nb-model {:hidden true :data-model p}]
                (when dock [:div.nb-dock (nb/bar-h dock)])))]])))

(defn page-h
  "The full HTML document."
  [doc css js]
  (let [fr (= "fr" (get-in doc [:meta :language])) locked (get-in doc [:meta :locked])]
  [:html {:lang (or (get-in doc [:meta :language]) "en") :data-design (get-in doc [:meta :design])}
   [:head
    [:meta {:charset "utf-8"}]
    [:meta {:name "viewport" :content "width=device-width,initial-scale=1,viewport-fit=cover"}]
    ;; Light is the default; a reader who chose dark gets it before the first paint.
    [:script "try{var t=localStorage.getItem('dossier-theme');if(t==='dark'||t==='light')document.documentElement.dataset.theme=t}catch(e){}"]
    (for [href (design/font-links doc)] [:link {:rel "stylesheet" :href href}])
    [:title (String/replace (or (:title (:meta doc)) "Dossier") (Regex/compile! "\\s+—.*$") "")]
    (when-not locked [:link {:rel "stylesheet" :href "review.css"}])
    [:style css (design/css doc)]]
   [:body
    (if locked
      [:div.live [:i] [:span#stamp (ui/tr "live")] [:button#theme {:type "button"} (ui/tr "theme")]]
      [:div.live [:i] [:span#stamp (ui/tr "live")] [:a {:href "src"} "source .bl.org"]
       ;; Opt-in only: a dossier with `#+client_hide:` declares a client reading;
       ;; every other dossier keeps its bar exactly as it was.
       (when (or (:client_hide (get-in doc [:meta])) (:mode (get-in doc [:meta])))
         [:button#audience {:type "button" :aria-pressed (if (audience/client? doc) "true" "false")} "Client"])
       ;; Offered only when the page's own CSS carries a sober reading.
       (when (includes? (str css) "data-design=\"sober\"")
         [:button#design {:type "button" :aria-pressed (if (= "sober" (get-in doc [:meta :design])) "true" "false")} "Sober"])
       [:button#theme {:type "button"} (ui/tr "theme")]
       [:button#review-toggle {:type "button" :aria-controls "dossier-review" :aria-expanded "false"}
        (if fr "Commentaires" "Comments")]])
    [:main#doc (doc-h doc)]
    [:div#toast]
    (when-not locked (review/shell (get-in doc [:meta :language])))
    [:script js]
    (when-not locked [:script {:src "review.js" :defer true}])]]))
