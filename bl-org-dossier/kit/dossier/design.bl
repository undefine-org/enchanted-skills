; dossier/design.bl — the design languages a mockup can be drawn in.
;
; A screen or desk with `:design forest` (or a document with `#+design:
; forest`) gets the class `design-forest`. Each language is a literate
; module (`design/NAME.bl.org`) that owns its tokens and turns them into the
; CSS that re-skins the kit's mockups. The module is the single source: its
; showcase page, its CSS and its token checks are one file.
;
; Four blocks show a language instead of describing it; each reads the
; module, so a token changed there changes the page:
;
;   #+begin_palette :design forest      swatches, light and dark
;   #+begin_type :design forest         the type scale, set in the face
;   #+begin_shape :design forest        radii and elevations on real cards
;   #+begin_motion :design forest       every motion token, playing

(ns dossier.design
  (:require [dossier.design.forest :as forest] [dossier.design.cassette :as cassette]
            [dossier.tone :as tone]))

(def languages
  "name → the module's `language` map:
   {:name :title :fonts [href] :css :font :light :dark :palette :type :radii :shadows :motion}
   A language with several faces may name :font-body, :font-ui, :font-display
   and :font-data; each falls back to :font."
  {"forest" forest/language "cassette" cassette/language})

(defn- product-css
  "Languages that live with their product (a private repository, say): CSS
   files styling `.design-NAME`, named by DOSSIER_DESIGN_CSS (comma-separated),
   read per page so a regenerated file shows at once."
  []
  (let [paths (filter (fn [p] (and (not= "" p) (File/regular? p)))
                      (map trim (split (or (System/get_env "DOSSIER_DESIGN_CSS") "") ",")))]
   (map (fn [p] (File/read! p)) paths)))

(defn- report-vars [language colors]
  (let [face (fn [k] (or (get language k) (:font language)))]
    (str "--font-body:" (face :font-body) ";--font-display:" (face :font-display)
         ";--font-ui:" (face :font-ui) ";--font-data:" (face :font-data) ";"
         (join ";" (for [[kit token] [["bg" :paper] ["paper" :inset] ["card" :card]
                                      ["line" :line] ["latte" :edge] ["ink" :ink]
                                      ["muted" :muted] ["mocha" :secondary] ["clay" :forest]
                                      ["sage" :success] ["ochre" :pending] ["slate" :neutral] ["plum" :lilac]]]
                     (str "--" kit ":" (get colors token)))))))

(defn- language-vars
  "A language's own tokens on the report root as well as on its mockups, so
   report rules may speak the language's names (--f-side, --f-amber) and not
   only the kit's role variables."
  [language colors]
  (str (join ";" (for [[k v] colors] (str "--f-" (name k) ":" v)))
       ";"
       (join ";" (for [[k v] (:shadows language)] (str "--f-shadow-" (name k) ":" v)))))

(defn- report-css [language]
  (let [selector (str "html[data-design=\"" (:name language) "\"]")]
    (str selector "{" (language-vars language (:light language)) ";" (report-vars language (:light language)) "}"
         "@media(prefers-color-scheme:dark){" selector ":not([data-theme=\"light\"]){"
         (language-vars language (:dark language)) ";" (report-vars language (:dark language)) "}}"
         selector "[data-theme=\"dark\"]{" (language-vars language (:dark language)) ";"
         (report-vars language (:dark language)) "}")))

(defn css
  "The CSS the page needs: only the languages this document wears (its
   #+design:, and any block's :design NAME), so one language's selectors
   never reach a document that does not use it. Without a document (a host
   asking for everything) every registered language is included."
  ([] (css nil))
  ([doc]
   (let [used (if doc
                (let [theme (get-in doc [:meta :design])
                      chosen (set (concat (when theme [theme])
                                          (keep (fn [node] (get-in node [:attrs :design])) (:nodes doc))))]
                  (if (empty? chosen) [] (filter (fn [l] (contains? chosen (:name l))) (vals languages))))
                (vals languages))]
     (join "\n" (concat (map :css used) (map report-css used) (product-css))))))

(defn font-links
  "Load only faces used by this document. An external language supplies its own
   font assets; unrelated registered languages do not leak into its report."
  [doc]
  (let [theme (get-in doc [:meta :design])
        chosen (set (concat (when theme [theme])
                            (keep (fn [node] (get-in node [:attrs :design])) (:nodes doc))))
        legacy-desk? (some (fn [node] (and (= "desk" (:lang node))
                                          (or (= "none" (get-in node [:attrs :design]))
                                              (and (nil? theme) (nil? (get-in node [:attrs :design])))))) (:nodes doc))]
    (vec (distinct
           (concat
             (when (or (nil? theme) (= theme "none"))
               ["https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"])
             (when legacy-desk?
               ["https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:opsz,wght,SOFT@9..144,400..600,100&family=Literata:opsz,wght@7..72,400..600&display=swap"])
             (mapcat (fn [name] (:fonts (get languages name))) chosen))))))

(defn register!
  "A product language that lives in its own repository registers its
   `language` map at load (a host script calls this before serving), so the
   showcase blocks can draw it. Its CSS still comes from DOSSIER_DESIGN_CSS."
  [language]
  (Application/put_env :beam_lisp :dossier-languages
    (assoc (or (Application/get_env :beam_lisp :dossier-languages) {}) (:name language) language)))

(defn- lang-of [nd]
  (let [k (or (:design (:attrs nd)) "forest")]
    (or (get languages k) (get (Application/get_env :beam_lisp :dossier-languages) k))))

(defn- frame
  "A showcase block: drawn inside `design-NAME` so it wears the language."
  [nd kind body]
  (let [l (lang-of nd) a (:attrs nd)]
    [:figure {:class (str "lang-show " kind " design-" (:name l))}
     (when (:title a) [:figcaption (:title a)])
     body]))

(defn- palette-h [nd]
  (let [l (lang-of nd)]
    (frame nd "palette"
      (for [[group ks] (:palette l)]
        [:div.f-group
         [:h5 group]
         [:div.f-swatches
          (for [k ks]
            [:div.f-sw
             [:div.f-chip [:i {:style (str "background:" (get (:light l) k))}] [:i {:style (str "background:" (get (:dark l) k))}]]
             [:b (name k)]
             [:code (str (get (:light l) k) " · " (get (:dark l) k))]])]]))))

(defn- type-h [nd]
  (let [l (lang-of nd)]
    (frame nd "type"
      (for [t (:type l)]
        [:div.f-type
         [:span.f-type-meta (str (:role t) " · " (:size t) "/" (:lh t) " · " (:weight t))]
         [:div {:style (str "font:" (:weight t) " " (:size t) "px/" (:lh t) " " (or (:family t) (:font l))
                            ";letter-spacing:" (or (:ls t) 0) "px;color:var(--f-" (name (or (:ink t) :ink)) ")")}
          (:sample t)]]))))

(defn- shape-h [nd]
  (let [l (lang-of nd)]
    (frame nd "shape"
      (list
        [:div.f-shapes
         (for [[k r] (:radii l)]
           [:div.f-shape {:style (str "border-radius:" r "px")} [:b (name k)] [:code (str r "px")]])]
        [:div.f-shapes
         (for [[k s] (:shadows l)]
           [:div.f-shape.lift {:style (str "box-shadow:" s)} [:b (name k)] [:code s]])]))))

(defn- motion-h [nd]
  (let [l (lang-of nd)]
    (frame nd "motion"
      [:div.f-motions
       (for [m (:motion l)]
         [:div.f-motion
          [:div.f-stage [:div {:class (str "f-demo fm-" (:name m))} [:span]]]
          [:b (:name m)]
          [:code (str (:ms m) "ms · " (:ease m))]
          [:p (:use m)]])])))

(def night-keys
  "The roles the comparison paints with; a language's :roles names its keys
   through :steps, :text, :solids and :fields."
  [:page :card :raised :field :line :ink :ink-2 :ink-3 :accent :solid :on-solid])

(defn- night-colors
  "Map a language's tokens onto the comparison's roles through its :roles:
   :card [card page], the last of :steps is the raised surface, :text the
   tiers, the first solid and the first accent, the first field."
  [l theme]
  (let [r (:roles l) [card page] (:card r) solid (first (:solids r))
        [ink ink-2 ink-3] (:text r) [field _] (first (:fields r))]
    {:page (get theme page) :card (get theme card) :raised (get theme (last (:steps r)))
     :field (get theme field) :line (or (get theme :line) (get theme :line-subtle))
     :ink (get theme ink) :ink-2 (get theme ink-2) :ink-3 (get theme ink-3)
     :accent (get theme (first (first (:accents r)))) :solid (get theme solid)
     :on-solid (or (get theme (keyword (str "on-" (name solid)))) (get theme :on-action))
     :frame (when-let [[f _] (:frame r)] (get theme f))}))

(defn- night-panel
  "One mock surface: a page, a card with a title, two text tiers, a field
   and a filled action, then a raised menu. Real tokens, inline, so the three
   panels sit side by side regardless of the page's own theme."
  [title c shadow note]
  (let [card (:card c)]
    [:div.n-panel {:class (when (:frame c) "n-framed") :style (str "background:" (:page c) ";color:" (:ink c))}
     (when (:frame c) [:div.n-frame {:style (str "background:" (:frame c))} [:i] [:i] [:i]])
     [:div.n-label {:style (str "color:" (:ink-3 c))} title]
     [:div.n-card {:style (str "background:" card ";border:1px solid " (:line c) ";box-shadow:" (:rest shadow))}
      [:div.n-title "Needs you"]
      [:div.n-body {:style (str "color:" (:ink-2 c))} "The draft is ready for review."]
      [:div.n-meta {:style (str "color:" (:ink-3 c))} "Othman · 2 min ago · "
       [:span {:style (str "color:" (:accent c) ";font-weight:600")} "Open thread"]]
      [:div.n-field {:style (str "background:" (:field c) ";border:1px solid " (:line c) ";color:" (:ink-3 c))} "Reply…"]
      [:div.n-row
       [:span.n-solid {:style (str "background:" (:solid c) ";color:" (:on-solid c))} "Approve"]
       [:span.n-ghost {:style (str "border:1px solid " (:line c) ";color:" (:ink c))} "Later"]]]
     [:div.n-raised {:style (str "background:" (:raised c) ";border:1px solid " (:line c) ";box-shadow:" (:raise shadow))}
      [:span "Raised · a menu"] [:span {:style (str "color:" (:ink-3 c))} "⌘K"]]
     (when note [:div.n-note {:style (str "color:" (:ink-3 c))} note])]))

(defn- measures [l theme]
  (let [r (tone/oomph theme (:roles l))]
    (if (:ok? r) "every oomph floor met"
        (join " · " (map (fn [f] (str (name (:check f)) " " (join "/" (map name (:pair f))) " " (:value f) " < " (:min f)))
                         (:failures r))))))

(def ^:private day-shadow {:rest "0 1px 2px rgb(0 0 0 / .06)" :raise "0 10px 30px rgb(0 0 0 / .12)"})
(def ^:private flat-shadow {:rest "none" :raise "0 10px 30px rgb(0 0 0 / .12)"})

(defn- night-h [nd]
  (let [l (lang-of nd)]
    (frame nd "night"
      [:div.n-grid
       (night-panel "Day" (night-colors l (:light l)) day-shadow nil)
       (when (:night-was l)
         (night-panel "Night, before" (night-colors l (:night-was l)) flat-shadow (measures l (:night-was l))))
       (night-panel "Night, now" (night-colors l (:dark l)) tone/elevation (measures l (:dark l)))])))

(defn block-h
  "Hiccup for a showcase block, or nil when `nd` is not one."
  [nd]
  (case (:lang nd)
    "palette" (palette-h nd)
    "type" (type-h nd)
    "shape" (shape-h nd)
    "motion" (motion-h nd)
    "night" (night-h nd)
    nil))
