   "attach" ["M20 11l-8 8a5 5 0 0 1-7-7l9-9a3 3 0 0 1 4 4l-9 9a1 1 0 0 1-2-2l8-8"]
   "grid" ["M4 4h7v7H4z" "M13 4h7v7h-7z" "M4 13h7v7H4z" "M13 13h7v7h-7z"]
   "list" ["M8 6h12" "M8 12h12" "M8 18h12" "M4 6h.01" "M4 12h.01" "M4 18h.01"]
   "board" ["M4 4h4v16H4z" "M10 4h4v10h-4z" "M16 4h4v13h-4z"]
   "split" ["M4 4h16v16H4z" "M12 4v16"]
   "spark" ["M12 3v4" "M12 17v4" "M3 12h4" "M17 12h4" "M6 6l2.5 2.5" "M15.5 15.5L18 18" "M18 6l-2.5 2.5" "M8.5 15.5L6 18"]})

(defn ico
  "The icon named `nm`, or the literal text when there is no such icon."
  [nm]
  (if-let [ps (get icon-paths nm)]
    [:svg {:class "ic" :viewBox "0 0 24 24" :aria-hidden "true"} (for [d ps] [:path {:d d}])]
    (str "@" nm)))

(def ^:private icon-re (Regex/compile! "(@[a-z][a-z-]*)"))

(defn mdi
  "md, plus `@name` icons — the inline language of mockups."
  [s]
  (if (or (nil? s) (= "" s))
    (list)
    (for [piece (Regex/split icon-re s (list (tuple :include_captures true)))
          :when (not= "" piece)]
      (if (and (starts-with? piece "@") (contains? icon-paths (subs piece 1)))
        (ico (subs piece 1))
        (md piece)))))

(defn slug [s]
  (-> (lower-case (str s))
      (String/replace (Regex/compile! "[^a-z0-9]+") "-")
      (String/replace (Regex/compile! "^-|-$") "")))

(defn- paras
  "Body lines → paragraphs (blank lines split them)."
  [lines]
  (for [chunk (partition-by blank? lines) :when (not (blank? (first chunk)))]
    [:p (md (join " " (map trim chunk)))]))

(defn- n [x] (str (erlang/round x)))

(defn- wrap-words
  "Greedy word wrap of `s` to lines of at most `width` characters."
  [s width]
  (reduce (fn [acc w]
            (let [cur (last acc)]
              (if (and (some? cur) (<= (+ (count cur) 1 (count w)) width))
                (conj (pop acc) (str cur " " w))
                (conj acc w))))
          [] (String/split (trim s) " ")))

; ─── feedback: the reader answers, the file remembers ──────────────────────

(defn feedback-h
  "Answer controls for block `a` (its attrs map). `opts` is [[value label] …].
   Posting writes :answer/:note/:at back into the block header."
  [a opts prompt]
  (let [ans (:answer a)]
    [:form {:class (str "fb" (if ans " answered picked" "")) :data-id (:id a)}
     [:div.fb-prompt prompt]
     [:div.fb-opts
      (for [[v label] opts]
        [:button {:type "button" :class (if (= v ans) "opt on" "opt") :data-v v} label])]
     [:textarea {:name "note" :rows "2" :placeholder "Anything Claude should know (optional)"} (or (:note a) "")]
     [:div.fb-row
      [:button.send {:type "submit"} (if ans "Update" "Send to Claude")]
      [:span.fb-state (if ans (str "✓ answered " (or (:at a) "")) "awaiting you")]]]))

; ─── prose components ──────────────────────────────────────────────────────

(defn lede-h [b] [:div.lede (paras (:body b))])

(defn stats-h [b]
  [:div.stats
   (for [[v label note] (o/rows-of (:body b))]
     [:div.stat [:b v] [:span (md label)] (when note [:small (md note)])])])

(defn terms-h [b]
  [:dl.terms
   (for [[t d] (o/rows-of (:body b))]
     (list [:dt (md t)] [:dd (md d)]))])

(defn principles-h [b]
  [:ol.principles
   (for [[t d] (o/rows-of (:body b))]
     [:li [:b (md t)] [:span (md d)]])])

(defn callout-h [b]
  [:aside {:class (str "callout " (:lang b))}
   (when (:title (:attrs b)) [:b (md (:title (:attrs b)))])
   (paras (:body b))])

; ─── rosetta and matrix: one idea across many systems ──────────────────────

(defn rosetta-h [b]
  (let [rows (o/rows-of (:body b)) head (first rows)]
    [:div.rosetta {:style (str "--cols:" (count head))}
     [:div.r-row.r-head (for [h head] [:div h])]
     (for [r (rest rows)]
       [:div.r-row
        (map-indexed (fn [i c] [:div {:data-h (nth head i "")} (md c)]) r)])]))

(defn- mark [c]
  (let [[tok & more] (String/split c " ")
        rest-text (join " " more)
        dot (fn [k] (list [:i {:class (str "dot " k)}] (when (not (blank? rest-text)) [:span (md rest-text)])))]
    (cond
      (contains? #{"y" "✓" "yes"} tok) (dot "full")
      (contains? #{"~" "partial"} tok) (dot "half")
      (contains? #{"n" "–" "-" "no"} tok) (dot "none")
      :else (md c))))

(defn matrix-h [b]
  (let [rows (o/rows-of (:body b)) head (first rows)]
    [:div.scrollx
     [:table.matrix
      [:thead [:tr (for [h head] [:th (md h)])]]
      [:tbody
       (for [r (rest rows)]
         [:tr [:th (md (first r))] (for [c (rest r)] [:td (mark c)])])]]
     [:div.legend [:i.dot.full] "does it" [:i.dot.half] "partly" [:i.dot.none] "no"]]))

; ─── jobs, decisions, asks ─────────────────────────────────────────────────

(defn job-h [b]
  (let [a (:attrs b)]
    [:article.job {:id (str "job-" (:id a))}
     [:header [:span.chip (:id a)] [:h4 (md (:title a))]]
     [:blockquote.jtbd (paras (:body b))]
     [:dl.job-facts
      ;; reference products are named by the dossier (:codex-label …); Baton's labels stay the default
      (when (:codex a) (list [:dt (or (:codex-label a) "Codex does")] [:dd (md (:codex a))]))
      (when (:claude a) (list [:dt (or (:claude-label a) "Claude Code path")] [:dd (md (:claude a))]))
      (when (:decision a) (list [:dt.decide (or (:decision-label a) "Baton decides")] [:dd.decide (md (:decision a))]))]
     (when (:screen a) [:a.to-screen {:href (str "#screen-" (:screen a))} (str "See the screen → " (:screen a))])
     (feedback-h a [["spot-on" "Spot on"] ["close" "Close"] ["wrong" "Wrong job"]] "Is this the job?")]))

(defn decision-h [b]
  (let [a (:attrs b)]
    [:article.decision {:id (str "decision-" (:id a))}
     [:header [:span.chip (:id a)] [:span {:class (str "status " (or (:status a) "proposed"))} (or (:status a) "proposed")]]
     [:h4 (md (:title a))]
     (for [run (partition-by (fn [l] (starts-with? (trim l) "- [")) (filter (fn [l] (not (blank? l))) (:body b)))]
       (if (starts-with? (trim (first run)) "- [")
         (for [l run :let [t (trim l)]]
           (if (starts-with? t "- [x]")
             [:div.opt-row.chosen [:i "✓"] [:span (md (trim (subs t 5)))]]
             [:div.opt-row.alt [:i "·"] [:span (md (trim (subs t 5)))]]))
         [:p (md (join " " (map trim run)))]))
     (feedback-h a [["accept" "Agree"] ["rework" "Rework"] ["reject" "Disagree"]] "Your call")]))

(defn ask-h [b]
  (let [a (:attrs b)
        opts (for [o (String/split (or (:options a) "Yes|No") "|")] [(trim o) (trim o)])]
    [:article.ask {:id (str "ask-" (:id a))}
     [:header [:span.chip.q (:id a)] [:h4 (md (:title a))]]
     (paras (:body b))
     (feedback-h a opts "Pick one, or say more")]))

; ─── screens: a phone drawn from a line language ───────────────────────────

(defn- cols [rest-text] (vec (map trim (String/split rest-text "|"))))

(defn- btn-h
  "`Label!` primary, `Label?` quiet, `Label^` danger, else plain."
  [x]
  (cond (ends-with? x "!") [:span.btn.primary (mdi (subs x 0 (dec (count x))))]
        (ends-with? x "?") [:span.btn.quiet (mdi (subs x 0 (dec (count x))))]
        (ends-with? x "^") [:span.btn.danger (mdi (subs x 0 (dec (count x))))]
        :else [:span.btn (mdi x)]))

(defn- screen-line
  "One `verb rest` line of a screen body as hiccup."
  [line]
  (let [t (trim line)
        sp (index-of t " ")
        verb (if sp (subs t 0 sp) t)
        rest-text (if sp (trim (subs t (inc sp))) "")
        c (cols rest-text)]
    (case verb
      "bar" [:div.s-bar
             (if (starts-with? (first c) "< ") (list [:span.s-back "‹"] [:b (mdi (subs (first c) 2))]) [:b (mdi (first c))])
             (when (> (count c) 1) [:span.s-right (mdi (nth c 1))])]
      "sub" [:div.s-sub (mdi rest-text)]
      "chips" [:div.s-chips (for [x c] (if (ends-with? x "*") [:span.chip.on (mdi (subs x 0 (dec (count x))))] [:span.chip (mdi x)]))]
      "section" [:div.s-sec [:span (mdi (first c))] (when (> (count c) 1) [:em (nth c 1)])]
      "card" (let [[tone title meta body] c]
               [:div {:class (str "s-card " tone)}
                [:i.s-dot]
                [:div.s-card-main
                 [:div.s-card-top [:b (mdi title)] (when meta [:span (mdi meta)])]
                 (when body [:div.s-card-body (mdi body)])]])
      "ask" [:div.s-ask (mdi rest-text)]
      "actions" [:div.s-actions
                 (for [x c]
                   (btn-h x))]
      "msg" [:div {:class (str "s-msg " (first c))} (mdi (join " | " (rest c)))]
      "tool" [:div.s-tool [:span.s-tri "▸"] [:span (mdi (first c))] (when (> (count c) 1) [:em (mdi (nth c 1))])]
      "diff" [:div.s-diff [:span.plusminus (first c)] [:code (nth c 1 "")]]
      "code" [:pre.s-code rest-text]
      "input" [:div.s-input [:span (mdi (first c))] [:span.s-send (mdi (nth c 1 "↑"))]]
      "tabs" [:div.s-tabs (for [x c] (if (ends-with? x "*") [:span.on (mdi (subs x 0 (dec (count x))))] [:span (mdi x)]))]
      "banner" [:div {:class (str "s-banner " (first c))} (mdi (nth c 1 ""))]
      "note" [:div.s-note (mdi rest-text)]
      "row" [:div.s-row [:span (mdi (first c))] [:b (mdi (nth c 1 ""))]]
      "strip" [:div {:class (str "s-strip " (first c))} [:i.s-dot] [:span (mdi (nth c 1 ""))]
               (when (> (count c) 2) [:span.btn.small (mdi (nth c 2))])]
      "notif" (let [[app title body actions] c]
                [:div.s-notif
                 [:div.s-notif-app [:i "ω"] app [:em "now"]]
                 [:b (mdi title)] [:div (mdi body)]
                 (when actions [:div.s-notif-acts (for [x (String/split actions ",")] [:span (trim x)])])])
      "lock" [:div.s-lock [:b (first c)] [:span (nth c 1 "")]]
      "dest" (let [[icon title body] c]
               [:div.s-dest [:i (mdi icon)] [:div [:b (mdi title)] [:span (mdi body)]]])
      "spacer" [:div.s-spacer]
      [:div.s-note (mdi t)])))

(defn- screen-body
  "Lines → hiccup; a `sheet Title` line opens a bottom sheet over the rest."
  [lines]
  (let [lines (filter (fn [l] (not (blank? l))) lines)
        before (take-while (fn [l] (not (starts-with? (trim l) "sheet"))) lines)
        sheet (drop-while (fn [l] (not (starts-with? (trim l) "sheet"))) lines)]
    (list
      [:div.s-flow (map screen-line before)]
      (when (seq sheet)
        (list [:div.s-scrim]
              [:div.s-sheet [:div.s-grip] [:div.s-sheet-title (md (trim (subs (trim (first sheet)) 5)))]
               (map screen-line (rest sheet))])))))

(defn screen-h [b]
  (let [a (:attrs b) dark? (= "dark" (:theme a))]
    [:figure {:class (str "phone" (if dark? " lockscreen" "")) :id (str "screen-" (:id a))}
     [:div.device
      [:div.statusbar [:span "9:41"] [:span.notch] [:span "◔ ▮▮"]]
      [:div.screen (screen-body (:body b))]]
     [:figcaption
      [:div.cap-top [:span.chip (:id a)] [:b (md (:title a))]
       (when (:job a) [:a {:href (str "#job-" (:job a))} (str "job " (:job a))])]
      (when (:caption a) [:p (md (:caption a))])
      (feedback-h a [["love" "Love it"] ["fine" "Fine"] ["rework" "Rework"]] "How does it feel?")]]))

(defn screens-h
  "A `#+begin_screens` strip: consecutive screen blocks scroll sideways."
  [blocks]
  [:div.screens (map screen-h blocks)])

; ─── sequence: who says what to whom, in order ─────────────────────────────

(defn- sequence-steps
  "The same sequence as a numbered list, for a phone-width column."
  [rows]
  [:ol.seq-steps
   (for [l rows :let [t (trim l)] :when (not (starts-with? t "lanes "))]
     (cond
       (starts-with? t "==") [:li.div (trim (subs t 2))]
       (starts-with? t "note ")
       (let [m (Regex/run (Regex/compile! "^note\\s+([^:]+):\\s*(.*)$") t)]
         [:li.note [:span.who (trim (nth m 1))] (md (nth m 2))])
       :else
       (let [m (Regex/run (Regex/compile! "^(.+?)\\s*(=>|-->|->)\\s*(.+?)\\s*:\\s*(.*)$") t)]
         (when m
           (let [[_ from arrow to label] m]
             [:li {:class (case arrow "=>" "baton" "-->" "reply" "call")}
              [:span.who (trim from) (if (= (trim from) (trim to)) "" (str " → " (trim to)))]
              [:span.what (md label)]])))))])

(defn- sequence-svg [b lanes M S W H out]
    [:svg {:class "sequence" :viewBox (str "0 0 " W " " H) :style (str "min-width:" (n (* W 0.9)) "px")
            :role "img" :aria-label (or (:title (:attrs b)) "sequence")}
      [:defs [:marker {:id "sq-head" :viewBox "0 0 10 10" :refX "9" :refY "5" :markerUnits "userSpaceOnUse" :markerWidth "10" :markerHeight "10" :orient "auto-start-reverse"}
              [:path {:d "M0,0 L10,5 L0,10 z"}]]]
      (map-indexed
        (fn [i l]
          (let [[title sub] (String/split l " · ") cx (+ M (* S i))]
            [:g.sq-lane
             [:line.life {:x1 (n cx) :x2 (n cx) :y1 "50" :y2 (n (- H 6))}]
             [:rect {:x (n (- cx 74)) :y "8" :width "148" :height "42" :rx "9"}]
             [:text.t {:x (n cx) :y (if sub "26" "33") :text-anchor "middle"} title]
             (when sub [:text.s {:x (n cx) :y "42" :text-anchor "middle"} sub])]))
        lanes)
      (map identity out)])

(defn sequence-h [b]
  (let [rows (filter (fn [l] (not (blank? l))) (:body b))
        lane-line (first (filter (fn [l] (starts-with? (trim l) "lanes ")) rows))
        lanes (cols (subs (trim lane-line) 6))
        idx (into {} (map-indexed (fn [i l] [(first (String/split l " · ")) i]) lanes))
        S 168 M 92 W (+ (* 2 M) (* S (dec (count lanes))))
        x (fn [name] (+ M (* S (get idx (trim name) 0))))
        steps (reduce
                (fn [acc l]
                  (let [t (trim l) y (:y acc)]
                    (cond
                      (starts-with? t "lanes ") acc
                      (starts-with? t "==")
                      (let [label (trim (subs t 2))]
                        (-> acc (update :out conj
                                        [:g.sq-div
                                         [:line {:x1 "8" :x2 (n (- W 8)) :y1 (n y) :y2 (n y)}]
                                         [:text {:x (n (/ W 2)) :y (n (- y 6)) :text-anchor "middle"} label]])
                            (assoc :y (+ y 36))))
                      (starts-with? t "note ")
                      (let [m (Regex/run (Regex/compile! "^note\\s+([^:]+):\\s*(.*)$") t)
                            who (vec (map trim (String/split (nth m 1) ",")))
                            x1 (- (apply min (map x who)) 70) x2 (+ (apply max (map x who)) 70)
                            ls (wrap-words (nth m 2) (max 20 (erlang/round (/ (- x2 x1) 6.6))))
                            h (+ 12 (* 15 (count ls)))]
                        (-> acc (update :out conj
                                        [:g.sq-note
                                         [:rect {:x (n x1) :y (n (- y 14)) :width (n (- x2 x1)) :height (n h) :rx "6"}]
                                         (map-indexed (fn [i s] [:text {:x (n (/ (+ x1 x2) 2)) :y (n (+ y 2 (* 15 i))) :text-anchor "middle"} s]) ls)])
                            (assoc :y (+ y h 14))))
                      :else
                      (let [m (Regex/run (Regex/compile! "^(.+?)\\s*(=>|-->|->)\\s*(.+?)\\s*:\\s*(.*)$") t)]
                        (if (nil? m)
                          acc
                          (let [[_ from arrow to label] m
                                x1 (x from) x2 (x to)
                                self? (= x1 x2)
                                span (if self? 150 (max 120 (- (max x1 x2) (min x1 x2))))
                                ls (wrap-words label (max 18 (erlang/round (/ span 6.8))))
                                lift (* 14 (dec (count ls)))
                                y (+ y lift)
                                kind (case arrow "=>" "baton" "-->" "reply" "call")]
                            (-> acc (update :out conj
                                            [:g {:class (str "sq-msg " kind)}
                                             (if self?
                                               [:path {:d (str "M" (n x1) " " (n (- y 4)) " h34 v16 h-30") :marker-end "url(#sq-head)"}]
                                               [:line {:x1 (n x1) :x2 (n (if (> x2 x1) (- x2 6) (+ x2 6))) :y1 (n y) :y2 (n y) :marker-end "url(#sq-head)"}])
                                             (map-indexed (fn [i s]
                                                            [:text {:x (n (if self? (+ x1 42) (/ (+ x1 x2) 2)))
                                                                    :y (n (+ (- y 7 lift) (* 14 i) (if self? 8 0)))
                                                                    :text-anchor (if self? "start" "middle")} s])
                                                          ls)])
                                (assoc :y (+ y (if self? 40 34))))))))))
                {:y 84 :out []} rows)
        H (+ (:y steps) 10)
        svg (fn [] (sequence-svg b lanes M S W H (:out steps)))]
    [:div.seq
     [:div.scrollx.seq-wide (svg)]
     (sequence-steps rows)
     [:details.seq-narrow [:summary "As a diagram"] [:div.scrollx (svg)]]]))

; ─── graph: boxes on a grid, typed edges between them ──────────────────────

(defn graph-h [b]
  (let [rows (o/rows-of (:body b))
        nodes (for [r rows :when (starts-with? (first r) "node ")]
                (let [[c rr] (map (fn [s] (erlang/binary_to_integer (trim s))) (String/split (nth r 3 "0,0") ","))]
                  {:id (trim (subs (first r) 5)) :label (nth r 1 "") :sub (nth r 2 "") :col c :row rr :tone (nth r 4 "")}))
        edges (for [r rows :when (starts-with? (first r) "edge ")]
                (let [m (Regex/run (Regex/compile! "^edge\\s+(\\S+)\\s*(->|<->|--)\\s*(\\S+)$") (first r))]
                  {:from (nth m 1) :to (nth m 3) :arrow (nth m 2) :label (nth r 1 "") :style (nth r 2 "solid")}))
        CW 280 RH 132 BW 176 BH 64 M 104
        at (into {} (for [nd nodes] [(:id nd) [(+ M (* CW (:col nd))) (+ 56 (* RH (:row nd)))]]))
        W (+ (* 2 M) (* CW (apply max 0 (map :col nodes))))
        H (+ 112 (* RH (apply max 0 (map :row nodes))))
        clip (fn [[x1 y1] [x2 y2]]
               (let [dx (- x2 x1) dy (- y2 y1)
                     ax (if (< dx 0) (- dx) dx) ay (if (< dy 0) (- dy) dy)
                     tx (if (> ax 0) (/ (+ 6 (/ BW 2)) ax) 1.0e9)
                     ty (if (> ay 0) (/ (+ 6 (/ BH 2)) ay) 1.0e9)
                     t (min tx ty)]
                 [(+ x1 (* t dx)) (+ y1 (* t dy))]))]
    [:div.scrollx.graph-wrap {:data-hint "swipe ↔"}
     [:svg {:class "graph" :viewBox (str "0 0 " W " " H) :style (str "min-width:" (n (* W 0.82)) "px")
            :role "img" :aria-label (or (:title (:attrs b)) "graph")}
      [:defs [:marker {:id "gr-head" :viewBox "0 0 10 10" :refX "9" :refY "5" :markerUnits "userSpaceOnUse" :markerWidth "10" :markerHeight "10" :orient "auto-start-reverse"}
              [:path {:d "M0,0 L10,5 L0,10 z"}]]]
      (for [e edges :when (and (get at (:from e)) (get at (:to e)))]
        (let [p1 (get at (:from e)) p2 (get at (:to e))
              [x1 y1] (clip p1 p2) [x2 y2] (clip p2 p1)]
          [:g {:class (str "gr-edge " (:style e))}
           [:line (merge {:x1 (n x1) :y1 (n y1) :x2 (n x2) :y2 (n y2)}
                         (when (not= "--" (:arrow e)) {:marker-end "url(#gr-head)"})
                         (when (= "<->" (:arrow e)) {:marker-start "url(#gr-head)"}))]
           (when (not (blank? (:label e)))
             [:text {:x (n (/ (+ x1 x2) 2)) :y (n (- (/ (+ y1 y2) 2) 5)) :text-anchor "middle"} (:label e)])]))
      (for [nd nodes]
        (let [[cx cy] (get at (:id nd))]
          [:g {:class (str "gr-node " (:tone nd))}
           [:rect {:x (n (- cx (/ BW 2))) :y (n (- cy (/ BH 2))) :width (n BW) :height (n BH) :rx "12"}]
           [:text.t {:x (n cx) :y (n (- cy 4)) :text-anchor "middle"} (:label nd)]
           [:text.s {:x (n cx) :y (n (+ cy 15)) :text-anchor "middle"} (:sub nd)]]))]]))

; ─── dispatch ──────────────────────────────────────────────────────────────

; ─── desk: the same product on a desktop ────────────────────────────────────
;
; A desk reuses every screen verb and adds the regions of a desktop app:
;   nav @home Accueil* | @matter Affaires     the sidebar (`*` = here)
;   crumb Affaires › Dupont SA                 where you are
;   head Title | tone · Status | Act! | Act?   object, status, the action slot
;   meta @user Amina · @bot Atlas Copilot      facts about the object
;   col doc | col rail | col main              columns (doc draws paper)
; and document verbs, for the paper and its review:
;   page Mise en demeure                       the document's title
;   para text {+inserted+} {-deleted-} {~proposed~} {!to verify!} ‹P-01› ^1
;   point tone | kind | title | body | Opt* | Opt
;   comment 1 | who | text                     a comment, numbered like its ^1

(def ^:private doc-re (Regex/compile! "(\\{\\+.*?\\+\\}|\\{-.*?-\\}|\\{~.*?~\\}|\\{!.*?!\\}|‹[^›]+›|\\^\\d+)"))

(defn- doc-inline [s]
  (for [piece (Regex/split doc-re s (list (tuple :include_captures true))) :when (not= "" piece)]
    (let [inner (fn [] (subs piece 2 (- (count piece) 2)))]
      (cond (starts-with? piece "{+") [:ins (mdi (inner))]
            (starts-with? piece "{-") [:del (mdi (inner))]
            (starts-with? piece "{~") [:span.prop (mdi (inner))]
            (starts-with? piece "{!") [:mark (mdi (inner))]
            (starts-with? piece "‹") [:span.piece (subs piece 1 (dec (count piece)))]
            (starts-with? piece "^") [:sup.cm (subs piece 1)]
            :else (mdi piece)))))

(defn- opts-h [xs]
  [:div.d-opts (for [x xs] (if (ends-with? x "*") [:span.on (mdi (subs x 0 (dec (count x))))] [:span (mdi x)]))])

(defn- desk-line [line]
  (let [t (trim line)
        sp (index-of t " ")
        verb (if sp (subs t 0 sp) t)
        rest-text (if sp (trim (subs t (inc sp))) "")
        c (cols rest-text)]
    (case verb
      "page" [:div.d-page-h (mdi rest-text)]
      "para" [:p.d-para (doc-inline rest-text)]
      "point" (let [[tone kind title body & xs] c]
                [:div {:class (str "d-point " tone)}
                 [:div.d-kind (mdi kind)] [:b (mdi title)] (when body [:div.d-pbody (doc-inline body)])
                 (when (seq xs) (opts-h xs))])
      "comment" (let [[n who text] c]
                  [:div.d-comment [:sup.cm n] [:div [:b (mdi who)] [:div (doc-inline (or text ""))]]])
      "opts" (opts-h c)
      (screen-line line))))

(defn- desk-parts
  "Lines → {:nav [...] :top [...] :cols [[name lines] ...]}."
  [lines]
  (reduce (fn [acc l]
            (let [t (trim l)]
              (cond (blank? t) acc
                    (starts-with? t "nav ") (assoc acc :nav (cols (subs t 4)))
                    (or (starts-with? t "crumb ") (starts-with? t "head ") (starts-with? t "meta ") (and (starts-with? t "tabs ") (empty? (:cols acc))))
                    (update acc :top conj t)
                    (starts-with? t "col ") (update acc :cols conj [(trim (subs t 4)) []])
                    (empty? (:cols acc)) (update acc :cols conj ["main" [t]])
                    :else (update-in acc [:cols (dec (count (:cols acc))) 1] conj t))))
          {:nav nil :top [] :cols []} lines))

(defn- desk-top [t]
  (let [sp (index-of t " ") verb (subs t 0 sp) c (cols (trim (subs t (inc sp))))]
    (case verb
      "crumb" [:div.d-crumb (mdi (first c))]
      "meta" [:div.d-meta (for [x c] [:span (mdi x)])]
      "tabs" [:div.d-tabs (for [x c] (if (ends-with? x "*") [:span.on (mdi (subs x 0 (dec (count x))))] [:span (mdi x)]))]
      "head" (let [[title status & acts] c
                   [tone label] (when (and status (not= "" status)) (let [p (String/split status " · ")] (if (> (count p) 1) [(first p) (join " · " (rest p))] ["idle" (first p)])))]
               [:div.d-head [:div.d-title (mdi title)]
                (when label [:span {:class (str "d-st " tone)} [:i] (mdi label)])
                [:span.d-acts (map btn-h acts)]])
      nil)))

(defn desk-h [b]
  (let [a (:attrs b) {:keys [nav top cols]} (desk-parts (:body b))
        names (map first cols)]
    [:figure.desk {:id (str "desk-" (:id a))}
     [:div.d-frame
      [:div.d-chrome [:i] [:i] [:i] [:span (or (:url a) "knowledger · cabinet-atlas")]]
      [:div {:class (if nav "d-app" "d-app bare")}
       (when nav
         [:nav.d-nav [:div.d-firm "Cabinet Atlas"]
          (for [x nav] (if (ends-with? x "*") [:span.on (mdi (subs x 0 (dec (count x))))] [:span (mdi x)]))])
       [:div.d-main
        (keep desk-top top)
        [:div {:class (str "d-cols " (join "-" names))}
         (for [[nm ls] cols]
           [:div {:class (str "d-col " nm)}
            (if (= nm "doc") [:div.d-paper (map desk-line ls)] (map desk-line ls))])]]]]
     [:figcaption
      [:div.cap-top [:span.chip (:id a)] [:b (md (:title a))]
       (when (:job a) [:a {:href (str "#job-" (:job a))} (str "job " (:job a))])]
      (when (:caption a) [:p (md (:caption a))])
      (feedback-h a [["love" "Love it"] ["fine" "Fine"] ["rework" "Rework"]] "How does it feel?")]]))

(defn block->h [b]
  (case (:lang b)
    "lede" (lede-h b)
    "stats" (stats-h b)
    "terms" (terms-h b)
    "principles" (principles-h b)
    "note" (callout-h b)
    "warning" (callout-h b)
    "honest" (callout-h b)
    "rosetta" (rosetta-h b)
    "matrix" (matrix-h b)
    "job" (job-h b)
    "decision" (decision-h b)
    "ask" (ask-h b)
    "screen" (screens-h [b])
    "desk" (desk-h b)
    "sequence" (sequence-h b)
    "graph" (graph-h b)
    "quote" [:blockquote (paras (:body b))]
    [:pre {:class (str "block " (:lang b))} (join "\n" (:body b))]))
