   "file" ["M6 3h8l4 4v14H6z" "M14 3v4h4"]
   "word" ["M6 3h8l4 4v14H6z" "M14 3v4h4" "M9 11l1.5 6 1.5-4 1.5 4 1.5-6"]
   "check" ["M5 12l5 5 9-10"]
