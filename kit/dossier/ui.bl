  {"home" ["M3 11l9-7 9 7" "M5 10v10h14V10"]
   "matter" ["M3 7h18v13H3z" "M8 7V4h8v3" "M3 12h18"]
   "library" ["M4 4h4v16H4z" "M10 4h4v16h-4z" "M15.5 5l3.5-1 3 15-3.5 1z"]
   "playbook" ["M10 6h10" "M10 12h10" "M10 18h10" "M4 6l1 1 2-2" "M4 12l1 1 2-2" "M4 18l1 1 2-2"]
   "people" ["M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" "M3 20c0-3 3-5 6-5s6 2 6 5" "M16 5a3 3 0 0 1 0 6" "M21 20c0-2.5-1.5-4.3-4-4.9"]
